# ============================================================
# LogiTrak · Gestion administrative de flotte — déploiement VPS
# Copier en ".env" :  cp .env.example .env  puis éditer.
# ============================================================

# Port LIBRE publié sur le VPS (mappé vers le conteneur web).
APP_PORT=8090

# Base MongoDB dédiée et isolée à cette app.
DB_NAME=logitrak_fleet

# Laisser VIDE : le frontend appelle l'API en same-origin (/api) via le gateway Nginx.
REACT_APP_BACKEND_URL=

# CORS (frontend + API sur le même domaine -> * convient).
CORS_ORIGINS=https://documents.logitrak.ch

# ---- Navixy (import flotte + GPS live + cumul km) ----
NAVIXY_BASE_URL=https://api.eu.navixy.com/v2
NAVIXY_API_HASH=
# Écriture des champs communs vers Navixy (plaque, VIN, marque+modèle, année, couleur).
# false = lecture seule (les données locales restent canoniques).
NAVIXY_WRITE_ENABLED=true
# Données de démonstration fictives (véhicules/leasing/assurance) — JAMAIS en production.
SEED_DEMO_DATA=false

# ---- OCR / analyse de documents (Claude prioritaire, GPT/Emergent en secours) ----
ANTHROPIC_API_KEY=
EMERGENT_LLM_KEY=

# ---- Alertes e-mail (optionnel) ----
# EMAIL_PROVIDER : resend | sendgrid  (vide = envoi simulé/mocké)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
ALERT_RECIPIENTS=

# ---- Authentification superadmin (OBLIGATOIRE) ----
# JWT_SECRET : generer avec  openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=admin@logitrak.ch
ADMIN_PASSWORD=
# Mot de passe oublie apres changement dans l'app ? ADMIN_FORCE_RESET=true + restart, puis remettre false.
ADMIN_FORCE_RESET=false
# Console Super Admin plateforme (Lot 4) — compte cree/idempotent au demarrage
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FORCE_RESET=false

# ---- Base technique officielle ASTRA/OFROU (gratuite, aucune clé) ----
# Datasets publics (~800 Mo) téléchargés puis importés automatiquement en local.
# ASTRA_DATA_DIR est monté sur un volume Docker dédié (voir docker-compose.yml).
ASTRA_DATA_DIR=/data/astra
ASTRA_SYNC_ENABLED=true

# ---- SwissCarInfo (HISTORIQUE, optionnel — non utilisé par le resolver actif) ----
SWISSCARINFO_API_KEY=
SWISSCARINFO_BASE_URL=https://api.swisscarinfo.ch
