# =====================================================================
# Vhost Nginx de l'HÔTE (VPS) pour LogiTrak Flotte.
# Fichier : /etc/nginx/sites-available/flotte
# Remplacez "flotte.VOTRE_DOMAINE" par un sous-domaine LIBRE de votre choix.
# Ce vhost ne touche pas à vos autres apps : il ne fait que proxifier
# un sous-domaine dédié vers le port du stack Docker (APP_PORT).
# =====================================================================
server {
    listen 80;
    server_name flotte.VOTRE_DOMAINE;

    client_max_body_size 64M;

    location / {
        proxy_pass http://127.0.0.1:8090;   # = APP_PORT du docker-compose
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# Activation + SSL :
#   sudo ln -s /etc/nginx/sites-available/flotte /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d flotte.VOTRE_DOMAINE
